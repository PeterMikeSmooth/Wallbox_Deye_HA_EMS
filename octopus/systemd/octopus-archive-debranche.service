[Unit]
Description=Releve Octopus apres un debranchement de la voiture
Documentation=file:/home/raspAutel/projects/Wallbox_Deye_HA_EMS/octopus/octopus_archive.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=raspAutel
WorkingDirectory=/home/raspAutel/projects/Wallbox_Deye_HA_EMS/octopus
EnvironmentFile=/home/raspAutel/.octopus_env
ExecStart=/usr/bin/python3 /home/raspAutel/projects/Wallbox_Deye_HA_EMS/octopus/octopus_archive.py --si-debranche
TimeoutStartSec=300
